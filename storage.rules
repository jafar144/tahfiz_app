rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDocument() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
    }

    function hasUserDocument() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        );
    }

    function isAdmin() {
      return hasUserDocument()
        && (
          userDocument().data.role == 'admin'
          || userDocument().data.is_admin == true
        );
    }

    function isStaff() {
      return isAdmin()
        || (
          hasUserDocument()
          && userDocument().data.role == 'asatidz'
        );
    }

    function validImage() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function ownsRequestedUpload() {
      return signedIn()
        && request.resource.metadata.get('uploader_uid', '') == request.auth.uid;
    }

    match /santri_photos/{fileName} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    match /asatidz_photos/{fileName} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    // File versi baru dipisah per UID uploader. Dengan begitu write ke path
    // milik staff lain tetap mustahil meski operasi overwrite dianggap create
    // oleh SDK/Storage generation.
    match /syahadah_photos/{uploaderUid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isStaff()
        && uploaderUid == request.auth.uid
        && validImage()
        && ownsRequestedUpload();
      allow delete: if isAdmin();
    }

    // Foto versi lama masih dapat dibaca/dihapus admin, tetapi tidak boleh
    // ditimpa lagi oleh aplikasi client.
    match /syahadah_photos/{legacyFileName} {
      allow read: if signedIn();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
