# Salin menjadi .env.<firebase-project-id>, bukan .env global.
# Nilai rahasia harus masuk Secret Manager, bukan file ini.

# Identitas lembaga. Domain ini hanya pembentuk email login internal;
# tidak wajib berupa domain email publik.
AUTH_EMAIL_DOMAIN=YOUR_INSTITUTION.app
INSTITUTION_NAME=Nama Lembaga
PAYMENT_BANK_NAME=Nama Bank
PAYMENT_ACCOUNT_NUMBER=0000000000
PAYMENT_ACCOUNT_HOLDER=Nama Pemilik Rekening

# Kosong = password awal asatidz dibuat acak. Jika lembaga memilih password
# tetap, panjangnya minimal 12 karakter.
STAFF_INITIAL_PASSWORD=

# Aktifkan setelah App Check Play Integrity dan debug token sudah tervalidasi.
APP_CHECK_ENFORCED=false

# Domain server yang terlihat pada device Wablas, tanpa slash di belakang.
WABLAS_BASE_URL=https://YOUR_SERVER.wablas.com
# Biarkan false sampai token, secret key, nomor wali, dan template sudah dicek.
WABLAS_ENABLED=false
# Fallback jika nomor wali kosong/tidak valid.
WHATSAPP_ADMIN_PHONE=6281234567890

# Welcome santri dan grup WhatsApp. ID grup adalah tujuan internal yang
# diterima Wablas; invite URL adalah link https://chat.whatsapp.com/... untuk
# disematkan pada pesan welcome. Biarkan kosong selama Wablas belum diaktifkan.
APP_DOWNLOAD_URL=
WHATSAPP_GROUP_PUTRA_PAGI_ID=
WHATSAPP_GROUP_PUTRA_PAGI_INVITE_URL=
WHATSAPP_GROUP_PUTRA_SORE_ID=
WHATSAPP_GROUP_PUTRA_SORE_INVITE_URL=
WHATSAPP_GROUP_PUTRA_MALAM_ID=
WHATSAPP_GROUP_PUTRA_MALAM_INVITE_URL=
WHATSAPP_GROUP_PUTRI_PAGI_ID=
WHATSAPP_GROUP_PUTRI_PAGI_INVITE_URL=
WHATSAPP_GROUP_PUTRI_SORE_ID=
WHATSAPP_GROUP_PUTRI_SORE_INVITE_URL=
WHATSAPP_GROUP_PUTRI_MALAM_ID=
WHATSAPP_GROUP_PUTRI_MALAM_INVITE_URL=

# Endpoint rekonsiliasi database/guest web lama tidak ikut dideploy.
DEPLOY_LEGACY_HTTP_FUNCTIONS=false
LEGACY_ADMIN_HTTP_ENABLED=false

# Hanya diperlukan untuk project lama yang sengaja mengaktifkan grup di atas:
# DB_HOST=YOUR_DATABASE_HOST
# DB_PORT=3306
# DB_USER=YOUR_DATABASE_USER
# DB_NAME=YOUR_DATABASE_NAME
