{
  "name": "khoirun-functions",
  "description": "Cloud Functions aman untuk aplikasi tahfiz white-label",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "test": "npm run test:unit",
    "test:unit": "node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-tahfiz --only firestore,storage \"node --test test/securityRules.rules.js\"",
    "migrate:quiz-leaderboards": "node scripts/migrateQuizLeaderboardTiers.js",
    "migrate:santri-fiqih": "node scripts/migrateSantriFiqihClasses.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "7.3.0",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.24.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "uuid": "11.1.1"
  },
  "private": true
}
