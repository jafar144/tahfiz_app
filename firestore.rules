rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDocument() {
      return signedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath()).data;
    }

    function isAdmin() {
      return hasUserDocument()
        && (currentUser().role == 'admin' || currentUser().is_admin == true);
    }

    function isAsatidz() {
      return hasUserDocument() && currentUser().role == 'asatidz';
    }

    function isSantri() {
      return hasUserDocument() && currentUser().role == 'santri';
    }

    function isStaff() {
      return isAdmin() || isAsatidz();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentSantriHalaqahId() {
      return get(
        /databases/$(database)/documents/santri_profiles/$(request.auth.uid)
      ).data.get('halaqah_id', '');
    }

    // Hanya profil pengajar yang sedang membimbing akun santri ini yang boleh
    // dibaca. Ini menjaga nama/nomor pembimbing tetap berasal dari dokumen
    // terkini tanpa membuka daftar seluruh asatidz kepada santri.
    function isAssignedAsatidz(uid) {
      return isSantri()
        && currentSantriHalaqahId() is string
        && currentSantriHalaqahId().size() > 0
        && get(
          /databases/$(database)/documents/halaqahs/$(currentSantriHalaqahId())
        ).data.get('asatidz', {}).get('id', '') == uid;
    }

    // Tanggal absensi disimpan sebagai date-only UTC yang mewakili kalender
    // WIB. Penambahan tujuh jam di sini memastikan batas hari mengikuti WIB,
    // bukan timezone perangkat atau UTC.
    function wibToday() {
      return (request.time + duration.value(7, 'h')).date();
    }

    function isEditableSunday(eventDate) {
      return eventDate is timestamp
        && eventDate == eventDate.date()
        && eventDate.dayOfWeek() == 7
        && wibToday().dayOfWeek() == 7
        && eventDate == wibToday();
    }

    function isCreatableSunday(eventDate) {
      return isEditableSunday(eventDate);
    }

    function sundayFajrParentPath(weekId) {
      return /databases/$(database)/documents/sunday_fajr_attendance/$(weekId);
    }

    function validSundayWeekKey(weekKey) {
      return weekKey is string
        && weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validSundayFajrSummary(weekId, data) {
      return data.keys().hasAll([
          'week_key',
          'event_date',
          'participant_count',
          'total_hadir',
          'total_izin',
          'total_alpha',
          'revision',
          'schema_version',
          'created_by',
          'created_at',
          'updated_by',
          'updated_at',
        ])
        && data.keys().hasOnly([
          'week_key',
          'event_date',
          'participant_count',
          'total_hadir',
          'total_izin',
          'total_alpha',
          'revision',
          'schema_version',
          'created_by',
          'created_at',
          'updated_by',
          'updated_at',
        ])
        && validSundayWeekKey(weekId)
        && data.week_key == weekId
        && isEditableSunday(data.event_date)
        && data.participant_count is int
        && data.total_hadir is int
        && data.total_izin is int
        && data.total_alpha is int
        && data.participant_count >= 0
        && data.participant_count <= 497
        && data.total_hadir >= 0
        && data.total_izin >= 0
        && data.total_alpha >= 0
        && data.participant_count
          == data.total_hadir + data.total_izin + data.total_alpha
        && data.revision is int
        && data.revision >= 1
        && data.schema_version == 1
        && data.created_by is string
        && data.created_by.size() > 0
        && data.updated_by is string
        && data.updated_by.size() > 0
        && data.created_at is timestamp
        && data.updated_at is timestamp;
    }

    function validSundayFajrParticipant(weekId, participantId, data) {
      return data.keys().hasAll([
          'record_type',
          'santri_id',
          'santri_name',
          'santri_nis',
          'kelas',
          'week_key',
          'event_date',
          'status',
          'izin_reason',
        ])
        && data.keys().hasOnly([
          'record_type',
          'santri_id',
          'santri_name',
          'santri_nis',
          'kelas',
          'week_key',
          'event_date',
          'status',
          'izin_reason',
          'created_at',
          'updated_at',
        ])
        && data.record_type == 'sunday_fajr_participant'
        && validSundayWeekKey(weekId)
        && data.week_key == weekId
        && data.santri_id == participantId
        && data.santri_id is string
        && data.santri_id.size() > 0
        && data.santri_name is string
        && data.santri_name.size() > 0
        && data.santri_nis is string
        && data.kelas is string
        && data.kelas.size() > 0
        && isEditableSunday(data.event_date)
        && data.status in ['hadir', 'izin', 'alpha']
        && data.izin_reason is string
        && data.izin_reason == ''
        && (
          !data.keys().hasAny(['created_at'])
          || data.created_at is timestamp
        )
        && (
          !data.keys().hasAny(['updated_at'])
          || data.updated_at is timestamp
        );
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isAssignedAsatidz(uid);
      allow create, delete: if false;
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['phone', 'photo_url'])
        );
    }

    match /santri_profiles/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    match /asatidz_profiles/{uid} {
      allow read: if isOwner(uid) || isStaff() || isAssignedAsatidz(uid);
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    match /families/{familyId} {
      allow read: if isAdmin()
        || (
          isSantri()
          && resource.data.santri_ids is list
          && request.auth.uid in resource.data.santri_ids
        );
      allow create, update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (
          isSantri()
          && resource.data.santri_id == request.auth.uid
        );
      allow create, update, delete: if isAdmin();
    }

    match /monthly_reports/{reportId} {
      allow read: if isStaff()
        || (
          isSantri()
          && resource.data.santri_id == request.auth.uid
        );
      allow create: if isAdmin()
        || (
          isAsatidz()
          && request.resource.data.asatidz_id == request.auth.uid
        );
      allow update: if isAdmin()
        || (
          isAsatidz()
          && resource.data.asatidz_id == request.auth.uid
          && request.resource.data.asatidz_id == resource.data.asatidz_id
          && request.resource.data.santri_id == resource.data.santri_id
        );
      allow delete: if isAdmin();
    }

    match /halaqahs/{halaqahId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /halaqah_teacher_sessions/{guardId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /session_schedules/{scheduleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /asatidz_attendance/{attendanceId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /santri_attendance/{attendanceId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /sunday_fajr_attendance/{weekId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validSundayFajrSummary(weekId, request.resource.data)
        && isCreatableSunday(request.resource.data.event_date)
        && request.resource.data.revision == 1
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.updated_by == request.auth.uid
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;
      allow update: if isAdmin()
        && isEditableSunday(resource.data.event_date)
        && validSundayFajrSummary(weekId, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'total_hadir',
          'total_izin',
          'total_alpha',
          'revision',
          'updated_by',
          'updated_at',
        ])
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updated_by == request.auth.uid
        && request.resource.data.updated_at == request.time;
      allow delete: if false;

      match /participants/{participantId} {
        allow read: if isAdmin()
          || (
            isSantri()
            && resource.data.santri_id == request.auth.uid
          );
        allow create: if isAdmin()
          && validSundayFajrParticipant(
            weekId,
            participantId,
            request.resource.data
          )
          && isCreatableSunday(request.resource.data.event_date)
          && !exists(sundayFajrParentPath(weekId))
          && existsAfter(sundayFajrParentPath(weekId))
          && getAfter(sundayFajrParentPath(weekId)).data.revision == 1
          && getAfter(sundayFajrParentPath(weekId)).data.event_date
            == request.resource.data.event_date
          ;
        allow update: if isAdmin()
          && isEditableSunday(resource.data.event_date)
          && validSundayFajrParticipant(
            weekId,
            participantId,
            request.resource.data
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'izin_reason',
          ])
          && exists(sundayFajrParentPath(weekId))
          && existsAfter(sundayFajrParentPath(weekId))
          && getAfter(sundayFajrParentPath(weekId)).data.revision
            == get(sundayFajrParentPath(weekId)).data.revision + 1
          && getAfter(sundayFajrParentPath(weekId)).data.updated_by
            == request.auth.uid
          && getAfter(sundayFajrParentPath(weekId)).data.updated_at
            == request.time;
        allow delete: if false;
      }
    }

    // Collection-group query dari sisi santri memerlukan recursive wildcard.
    // Discriminator mencegah rule ini membuka subcollection "participants"
    // milik fitur lain yang mungkin ditambahkan di masa depan.
    match /{path=**}/participants/{participantId} {
      allow read: if resource.data.record_type == 'sunday_fajr_participant'
        && (
          isAdmin()
          || (
            isSantri()
            && resource.data.santri_id == request.auth.uid
          )
        );
    }

    match /meetings/{meetingId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if isStaff()
          || isOwner(memberId)
          || (
            signedIn()
            && resource.data.santri_id == request.auth.uid
          );
        allow create, update: if isStaff();
        allow delete: if isAdmin();
      }
    }

    match /kelulusan/{kelulusanId} {
      allow read: if signedIn();
      // Penulisan dilakukan oleh callable server agar satu santri hanya
      // memiliki satu foto per tanggal WIB dan replace berjalan atomik.
      allow create, update, delete: if false;
    }

    match /recitation_quiz_attempts/{attemptId} {
      allow read: if isStaff()
        || (
          signedIn()
          && resource.data.user_id == request.auth.uid
        );
      allow create: if isSantri()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.role == 'santri';
      allow update, delete: if false;
    }

    match /quiz_leaderboards/{monthKey}/{boardId}/{uid} {
      allow read: if signedIn();
      allow create, update: if isSantri()
        && isOwner(uid)
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.role == 'santri';
      allow delete: if isAdmin();
    }

    match /surah_journey_progress/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if isAdmin();
    }

    match /device_tokens/{token} {
      allow read: if isAdmin();
      allow create: if hasUserDocument()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == currentUser().role;
      allow update: if hasUserDocument()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == currentUser().role;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /app_config/runtime {
      allow read: if signedIn();
      allow write: if false;
    }

    // Energi, lock, dan semua koleksi yang belum dikenal hanya boleh diakses
    // melalui Admin SDK/Cloud Functions.
    match /quiz_energy_weeks/{documentId} {
      allow read, write: if false;
    }

    match /app_locks/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
